<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="SHOP APP"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Cantidad de registros -->
            <Label x:Name="category"
                   FontSize="18" />

            <Label x:Name="client"
                   FontSize="18" />

            <Label x:Name="product"
                   FontSize="18" />

            <BoxView HeightRequest="2" />

            <!-- 1. Productos de Computadoras -->
            <Label Text="1. Productos de la categoría Computadoras"
                   FontSize="20"
                   FontAttributes="Bold" />

            <VerticalStackLayout x:Name="listaComputadoras"
                                 Spacing="5" />

            <BoxView HeightRequest="2" />

            <!-- 2. Productos mayores a $1000 -->
            <Label Text="2. Productos con precio mayor a $1000"
                   FontSize="20"
                   FontAttributes="Bold" />

            <VerticalStackLayout x:Name="listaProductosCaros"
                                 Spacing="5" />

            <BoxView HeightRequest="2" />

            <!-- 3. Categoría del producto más caro -->
            <Label Text="3. Producto más caro"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Label x:Name="productoMasCaro"
                   FontSize="18" />

            <Label x:Name="precioMasCaro"
                   FontSize="18" />

            <Label x:Name="categoriaMasCaro"
                   FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
