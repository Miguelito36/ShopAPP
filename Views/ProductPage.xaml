<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.ProductPage"
             xmlns:handlers="clr-namespace:ShopApp.Handlers"
             Title="ProductPage">

    <Shell.SearchHandler>
        <handlers:ProductoBusquedaHandler
            Placeholder="Buscar Producto"
            ShowsResults="True"
            ItemTemplate="{StaticResource ProductDataTemplate}"
        />
    </Shell.SearchHandler>

    <RefreshView Command="{Binding RefreshProductsCommand}"  IsRefreshing="{Binding IsRefreshing}">
        <CollectionView 
        SelectionMode="Single"
        ItemsSource="{Binding Products}"
        SelectedItem="{Binding ProductSelected, Mode=TwoWay}"
        ItemTemplate="{StaticResource ProductDataTemplate}"
        />
    </RefreshView>
</ContentPage>