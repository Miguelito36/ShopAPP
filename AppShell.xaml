<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShopApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShopApp.Views"
    Shell.FlyoutBehavior="Flyout"
    xmlns:info="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials"
    Title="ShopApp">

    <Shell.FlyoutHeader>
        <Image Source="dotnet_bot.png" Aspect="AspectFit" HeightRequest="150" />
    </Shell.FlyoutHeader>
    
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="10">
            <Label Text="{x:Static info:AppInfo.Name}" />
            <Label Text="{x:Static info:AppInfo.VersionString}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="Configuracion">
        <Tab Title="Resumen">
            <ShellContent
                Title="Dara System"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Clientes">
            <ShellContent
                Title="Clientes"
                ContentTemplate="{DataTemplate views:ClientPage}"
                Route="ClientPage" />
        </Tab>
        
        <Tab Title="Categorias">
            <ShellContent
        Title="Categorias"
        ContentTemplate="{DataTemplate views:CategoriesPage}"
        Route="CategoryPage" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Productos">
        <Tab Title="Productos">
            <ShellContent
        Title="Products"
        ContentTemplate="{DataTemplate views:ProductPage}"
        Route="ProductPage" />
        </Tab>
    </FlyoutItem>
    
    <ShellContent
        Title="Help Support"
        ContentTemplate="{DataTemplate views:HelpSupportPage}"
        Route="HelpSupportPage" />

    <MenuItem
        Text="Abrir Repo"
        Clicked="MenuItem_Clicked"
        />

</Shell>
